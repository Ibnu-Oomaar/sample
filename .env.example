# E-KAYDI WHMS — Enterprise Environment Variables Configuration

# Server
PORT=4000
NODE_ENV=development
APP_SECRET=ekaydi_super_secure_secret_entropy_2026

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=admin
DB_NAME=ekaydi_whms

# JWT & Authentication
JWT_ACCESS_SECRET=ekaydi_jwt_access_signature_key_2026
JWT_REFRESH_SECRET=ekaydi_jwt_refresh_signature_key_2026
JWT_EXPIRES_IN=3600s
JWT_REFRESH_EXPIRES_IN=7d

# Multi-Tenancy
DEFAULT_TENANT_ID=tenant-001
ENFORCE_TENANT_ISOLATION=true

# Offline Sync Gateway
SYNC_IDEMPOTENCY_TTL_HOURS=72
MAX_BATCH_OPERATIONS=50
